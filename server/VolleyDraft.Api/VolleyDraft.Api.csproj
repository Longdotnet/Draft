<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.17" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.17" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.0.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <Target Name="PrepareHdMorningBackgrounds" BeforeTargets="BeforeBuild" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Condition="Exists('Assets/SocialCards/social-card-01-hd.png')" Command="base64 -w 0 Assets/SocialCards/social-card-01-hd.png &gt; Assets/SocialCards/social-card-01.b64" />
    <Exec Condition="Exists('Assets/SocialCards/social-card-02-hd.png')" Command="base64 -w 0 Assets/SocialCards/social-card-02-hd.png &gt; Assets/SocialCards/social-card-02.b64" />
    <Exec Condition="Exists('Assets/SocialCards/social-card-03-hd.png')" Command="base64 -w 0 Assets/SocialCards/social-card-03-hd.png &gt; Assets/SocialCards/social-card-03.b64" />
    <Exec Condition="Exists('Assets/SocialCards/social-card-04-hd.png')" Command="base64 -w 0 Assets/SocialCards/social-card-04-hd.png &gt; Assets/SocialCards/social-card-04.b64" />
    <!-- Compatibility alias for old persisted BackgroundId=5 rows. New Morning selection only uses 1..4. -->
    <Exec Condition="Exists('Assets/SocialCards/social-card-01-hd.png')" Command="base64 -w 0 Assets/SocialCards/social-card-01-hd.png &gt; Assets/SocialCards/social-card-05.b64" />
  </Target>

  <Target Name="PrepareHdNightBackgrounds" BeforeTargets="BeforeBuild" Condition="'$(OS)' != 'Windows_NT'">
    <Error Condition="!Exists('Assets/SocialCards/Night/night-card-01-hd.png')" Text="Missing Night HD asset 01." />
    <Error Condition="!Exists('Assets/SocialCards/Night/night-card-02-hd.png')" Text="Missing Night HD asset 02." />
    <Error Condition="!Exists('Assets/SocialCards/Night/night-card-03-hd.png')" Text="Missing Night HD asset 03." />
    <Exec Command="base64 -w 0 Assets/SocialCards/Night/night-card-01-hd.png &gt; Assets/SocialCards/Night/night-card-01.b64" />
    <Exec Command="base64 -w 0 Assets/SocialCards/Night/night-card-02-hd.png &gt; Assets/SocialCards/Night/night-card-02.b64" />
    <Exec Command="base64 -w 0 Assets/SocialCards/Night/night-card-03-hd.png &gt; Assets/SocialCards/Night/night-card-03.b64" />
    <Exec Command="base64 -w 0 Assets/SocialCards/Night/night-card-01-hd.png &gt; Assets/SocialCards/Night/night-card-04.b64" />
    <Exec Command="base64 -w 0 Assets/SocialCards/Night/night-card-02-hd.png &gt; Assets/SocialCards/Night/night-card-05.b64" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets/Posters/court-index-volleyball-study-02.jpg"
                      LogicalName="VolleyDraft.Api.Assets.Posters.CourtIndexVolleyballStudy02.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/social-card-01.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.SocialCard01.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/social-card-02.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.SocialCard02.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/social-card-03.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.SocialCard03.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/social-card-04.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.SocialCard04.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/social-card-05.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.SocialCard05.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/Night/night-card-01.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.Night.NightCard01.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/Night/night-card-02.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.Night.NightCard02.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/Night/night-card-03.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.Night.NightCard03.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/Night/night-card-04.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.Night.NightCard04.jpg" />
    <EmbeddedResource Include="Assets/SocialCards/Night/night-card-05.b64"
                      LogicalName="VolleyDraft.Api.Assets.SocialCards.Night.NightCard05.jpg" />
  </ItemGroup>

</Project>