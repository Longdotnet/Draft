{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://volley-draft.onrender.com"
    ]
  },
  "Database": {
    "Provider": "Postgres"
  },
  "Public": {
    "BaseUrl": ""
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=volley_draft;Username=postgres;Password=123123"
  },
  "Jwt": {
    "Issuer": "VolleyDraft",
    "Audience": "VolleyDraftClient",
    "Key": "dev-only-volley-draft-mvp-jwt-signing-key-change-later"
  },
  "ZaloBot": {
    "ConversationTtlMinutes": 15,
    "ExactCommandCooldownSeconds": 2,
    "AiCooldownSeconds": 10,
    "AiPerUserPerMinute": 4,
    "AiPerGroupPerMinute": 20,
    "AiStyleEnabled": true,
    "ClassifierConfidenceThreshold": 0.72,
    "LearnedRuleSimilarityThreshold": 0.82,
    "Ambient": {
      "Enabled": true,
      "ShadowMode": false,
      "WouldReplyThreshold": 60,
      "RecentWindowMinutes": 5,
      "MaxRecentMessages": 40,
      "BotCooldownSeconds": 2,
      "BusyGroupMessagesPerTwoMinutes": 8,
      "MemberAssist": {
        "Enabled": true,
        "Rescue": {
          "Enabled": true,
          "MaxNudges": 3,
          "GroupCooldownMinutes": 10,
          "RetryMinutes": 10
        }
      },
      "FactPilot": {
        "Enabled": true,
        "MinimumScore": 60
      },
      "SocialPilot": {
        "Enabled": true,
        "SendEnabled": true,
        "MinimumScore": 90,
        "MaxContextMessages": 8,
        "MaxReplyChars": 180,
        "MaxTrashTalkLevel": 3,
        "AllowProfanity": true,
        "AllowHardRoast": false
      },
      "Presence": {
        "Enabled": true,
        "SendEnabled": true,
        "QuietMinutes": 90,
        "MinBotIntervalMinutes": 60,
        "MaxProactivePerDay": 4,
        "StartHour": 8,
        "EndHour": 23,
        "TrashTalkLevel": 3
      },
      "DomainEventPilot": {
        "Enabled": false,
        "SendEnabled": false
      }
    }
  },
  "Npc11": {
    "AiEnabled": true,
    "ArtProvider": "cloudflare-flux2-klein-4b",
    "ArtWorkerBaseUrl": "",
    "ArtWorkerKey": "",
    "ArtTimeoutSeconds": 45,
    "Cloudflare": {
      "AccountId": "",
      "ApiToken": "",
      "Model": "@cf/black-forest-labs/flux-2-klein-4b",
      "TimeoutSeconds": 45
    }
  },
  "ZaloActivitySync": {
    "BoardPageSize": 50,
    "MaxBoardPages": 100,
    "IncrementalBoardPages": 5,
    "MessageHistoryCount": 2000,
    "RetryCount": 4,
    "RetryDelayMs": 750,
    "PauseBetweenRequestsMs": 150,
    "IncrementalMinutes": 60,
    "LeaseMinutes": 10
  },
  "ZaloActivityRules": {
    "NewMemberDays": 14,
    "ActiveDays": 14,
    "RegularDays": 30,
    "InactiveDays": 90,
    "AtRiskMissedPolls": 3
  },
  "Scheduler": {
    "Key": "",
    "PollRefreshMinutes": 20,
    "RetryMinutes": 10,
    "UrgentWindowHours": 1,
    "UrgentDelayMinutes": 0
  }
}
