# Shared secret; use the same value as Draft API Npc11__ArtWorkerKey.
NPC11_WORKER_KEY=change-me

# Best-quality open model currently wired by default.
NPC11_MODEL_ID=Qwen/Qwen-Image-Edit-2511

# none | model | sequential. 'model' is a useful balance for consumer GPUs.
NPC11_OFFLOAD=model
NPC11_STEPS=40
NPC11_TRUE_CFG_SCALE=4.0
NPC11_MIN_REFERENCE_EDGE=512
NPC11_MAX_REFERENCE_EDGE=1024
